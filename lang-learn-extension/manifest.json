{
  "manifest_version": 3,
  "name": "外语视频学习助手",
  "version": "0.7.10",
  "description": "在 B 站看外语视频时辅助学习：右侧字幕列表逐句跟读，点词查词（可联动本机欧路词典），双击存生词并按记忆曲线复习，支持单句音频下载。数据全部存本地，无需账号。支持 Chrome / Edge / 夸克。",
  "permissions": ["storage", "activeTab", "tabCapture", "downloads"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/*",
        "https://www.bilibili.com/*",
        "https://player.bilibili.com/*",
        "https://m.bilibili.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "外语视频学习助手"
  }
}
