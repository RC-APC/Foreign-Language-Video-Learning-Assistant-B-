{
  "manifest_version": 3,
  "name": "外语视频学习助手",
  "version": "0.7.36",
  "description": "在 B 站 / YouTube 看外语视频时辅助学习：右侧字幕列表逐句跟读（▶ 播放、🎤 跟读录音并给出相似度评分），点词查词（可联动本机欧路词典 / 导入本地词库），双击存生词、加注释、按记忆曲线复习，支持大模型 API 翻译（译文边翻边上屏）与生词导出备份。数据全部存本地，无需账号。支持 Chrome / Edge / 夸克 / Kiwi。",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://api.dictionaryapi.dev/*",
    "https://en.wiktionary.org/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.deepseek.com/*",
    "https://api.siliconflow.cn/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/*",
        "https://www.bilibili.com/*",
        "https://player.bilibili.com/*",
        "https://m.bilibili.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["yt-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "外语视频学习助手"
  },
  "options_page": "vocab.html"
}
